# Copy to .env.backup and keep this file owner-only (chmod 600).
# Generate with: openssl rand -hex 32
GLOBALGOV_BACKUP_KEY_HEX=REPLACE_WITH_64_HEX_CHARACTERS
BACKUP_DIR=/var/lib/globalgov/backups
BACKUP_RETENTION_DAYS=14
BACKUP_REQUIRE_REMOTE=true
# Must be an owner-controlled Linux host, absolute directory, and trailing slash.
BACKUP_REMOTE_TARGET=backupuser@backup-host:/srv/globalgov/backups/
