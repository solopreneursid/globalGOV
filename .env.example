# Copy to .env and replace every placeholder before starting the stack.
PUBLIC_DOMAIN=globalgov.example.com
ACME_EMAIL=ops@example.com

# Bootstrap/database-owner role. Used only by PostgreSQL initialization and migrations.
POSTGRES_DB=globalgov
POSTGRES_USER=globalgov_admin
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ADMIN_SECRET

# Runtime role: application and scheduler cannot create/drop schemas or roles.
APP_DB_USER=globalgov_app
APP_DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_APP_SECRET

# Backup role: read-only data access plus write access to backup_runs only.
BACKUP_DB_USER=globalgov_backup
BACKUP_DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_BACKUP_SECRET

# Separate least-privilege role used only to create/drop temporary restore-test databases.
RESTORE_TEST_DB_USER=globalgov_restore
RESTORE_TEST_DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_RESTORE_SECRET

# Application secrets. Leave empty until a separately approved signed collector is configured.
INGEST_HMAC_KEY=
MODERATOR_TOKEN=
SSB_AUTOMATED_ACCESS_APPROVED=false

# Optional operational tuning.
PGPOOL_MAX=10
MAX_REQUEST_BODY_BYTES=4194304
