FROM node:26-bookworm-slim AS node-runtime

FROM postgres:17-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends rsync openssh-client ca-certificates libatomic1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/bin/npm /usr/local/bin/npm
COPY --from=node-runtime /usr/local/bin/npx /usr/local/bin/npx
COPY --from=node-runtime /usr/local/lib/node_modules /usr/local/lib/node_modules

ENV NODE_ENV=production
ENV PATH="/usr/local/bin:${PATH}"
WORKDIR /app

COPY apps/govexam-radar/package.json apps/govexam-radar/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

COPY apps/govexam-radar/postgres-d1.mjs ./
COPY apps/govexam-radar/encrypted-backup.mjs ./
COPY apps/govexam-radar/postgres-backup.mjs ./
COPY apps/govexam-radar/backup-crypto.mjs ./
COPY apps/govexam-radar/document-backup.mjs ./
COPY apps/govexam-radar/postgres-restore-test.mjs ./
COPY apps/govexam-radar/backup-scheduler.mjs ./

RUN mkdir -p /var/lib/globalgov/backups /var/lib/postgresql/.ssh \
    && chmod 700 /var/lib/globalgov/backups /var/lib/postgresql/.ssh \
    && chown -R postgres:postgres /var/lib/globalgov /var/lib/postgresql/.ssh

USER postgres
ENTRYPOINT ["node", "backup-scheduler.mjs"]
